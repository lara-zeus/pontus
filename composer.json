{
    "name": "lara-zeus/pontus",
    "description": "subscriptions, plans, invoices, and features",
    "keywords": [
        "laravel",
        "lara-zeus",
        "pontus",
        "subscriptions",
        "plans",
        "invoices",
        "features",
        "manager",
        "filamentphp"
    ],
    "homepage": "https://larazeus.com/pontus",
    "support": {
        "issues": "https://github.com/lara-zeus/pontus/issues",
        "source": "https://github.com/lara-zeus/pontus"
    },
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "php coder",
            "email": "info@larazeus.com",
            "role": "Owner"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-pdo_sqlite": "*",
        "ext-sqlite3": "*",
        "lara-zeus/filament-plugin-tools": "^2.0",
        "rinvex/laravel-subscriptions": "dev-laravel-12",
        "lara-zeus/chaos": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "LaraZeus\\Pontus\\": "src",
            "LaraZeus\\Pontus\\Database\\Factories\\": "database/factories/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "pint": "vendor/bin/pint",
        "test:phpstan": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaraZeus\\Pontus\\PontusServiceProvider"
            ],
            "aliases": {
                "Pontus": "LaraZeus\\Pontus\\Facades\\Pontus"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "github",
            "url": "git@github.com:still-code/laravel-subscriptions.git"
        }
    ]
}
